{
  "name": "chat-adapter-zalo",
  "version": "0.2.0",
  "description": "Community Zalo adapter for Chat SDK - Zalo Bot Platform",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "chat": "^4.43.0"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.43.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "chat": "^4.43.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/buiducnhat/chat-adapter-zalo.git"
  },
  "homepage": "https://github.com/buiducnhat/chat-adapter-zalo#readme",
  "bugs": {
    "url": "https://github.com/buiducnhat/chat-adapter-zalo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chat",
    "chat-sdk",
    "zalo",
    "bot",
    "adapter",
    "messaging",
    "community"
  ],
  "license": "MIT",
  "author": "Nhat Bui",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
